FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend ./backend
COPY frontend ./frontend
COPY scripts ./scripts
COPY tests ./tests
COPY pyproject.toml ./
COPY README.md ./
COPY openapi.yaml ./
COPY .env.example ./

EXPOSE 8765

CMD ["python", "-m", "backend.humanproof.server", "--host", "0.0.0.0", "--port", "8765"]
